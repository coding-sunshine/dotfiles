# Blocks the #1 npm supply-chain vector: a compromised package's
# postinstall/preinstall script running arbitrary code on `npm install`
# (shai-hulud worm, chalk/debug takeover, etc). Trusted packages needing a
# native build (node-gyp, sharp) still rebuild fine via `npm rebuild <pkg>`.
ignore-scripts=true
audit=true
fund=false
